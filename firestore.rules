rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Diagnostic report cache: Authenticated clients can read cached scans
    match /scan_cache/{cacheKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Revenue ledger: append-only accounting. No client access — the
    // backend writes via Admin SDK and operators read via Business Center.
    match /revenue_events/{eventId} {
      allow read, write: if false;
    }

    // Deep-dive ledger: same treatment — backend writes, operators read.
    match /deepdive_receipts/{requestId} {
      allow read, write: if false;
    }

    // Debug-build client diagnostics: uploaded by explicit user action from
    // the Android Diagnostics sheet. Owner-only writes; no client reads.
    match /client_diagnostics/{requestId} {
      function validDiag() {
        return request.auth != null
          && requestId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$')
          && request.resource.data.keys().hasOnly(
               ['requestId', 'uid', 'createdAt', 'appVersion', 'buildType', 'lineCount', 'lines'])
          && request.resource.data.requestId == requestId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.lines is list
          && request.resource.data.lines.size() <= 300;
      }
      allow create: if validDiag();
      allow update: if validDiag() && resource.data.uid == request.auth.uid;
      allow read, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
