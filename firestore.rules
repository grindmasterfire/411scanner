rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Diagnostic report cache: Authenticated clients can read cached scans
    match /scan_cache/{cacheKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Revenue ledger: append-only accounting. No client access — the
    // backend writes via Admin SDK and operators read via Business Center.
    match /revenue_events/{eventId} {
      allow read, write: if false;
    }

    // Deep-dive ledger: same treatment — backend writes, operators read.
    match /deepdive_receipts/{requestId} {
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
