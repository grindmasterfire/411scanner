# Model configuration (Story 10.7). Not secrets: the Gemini key lives in Secret Manager.
PASS1_MODEL=gemini-3.6-flash
PASS2_MODEL=gemini-3.8-flash
MAX_GROUNDING_RETRIES=5
# Launch gates. Firebase manages function env from this file: a gate set by
# hand on a service is dropped on the next deploy (AD_GATE_ENFORCED was, on
# 2026-10-16, for ~10 minutes). Each gate is read only by its own function.
AD_GATE_ENFORCED=true
PLAY_VERIFY_ENABLED=true
