<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Scan history is device-local diagnostic history. It must not
             survive uninstall/reinstall — a fresh install showing stale
             results is a bug, not a feature.
             The quota DataStore (411_scan_quota) stays backed up so the
             free weekly tier cannot be farmed by reinstalling. -->
        <exclude domain="sharedpref" path="fouroneone_scan_history.xml"/>
    </cloud-backup>
</data-extraction-rules>
